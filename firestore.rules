rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global tap counter
    match /counters/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Country tap leaderboard (doc id = country code, e.g. JP, US)
    match /countries/{countryCode} {
      allow read: if true;
      allow write: if true;
    }
  }
}
